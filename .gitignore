# Unity project: keep this file beside Assets, Packages, and ProjectSettings.
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Commit source assets and their .meta files.

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log
*.blend1
*.blend1.meta

# Memory captures and recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated Rider plugin and local IDE settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.vs/
.vscode/
.gradle/
ExportedObj/
.consulo/

# Generated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Build and package outputs
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Test Runner generated files
InitTestScene*.unity*

# Addressables generated content
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Generated test scenes and scene dependency cache
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
